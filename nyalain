clear
HIJAU='\033[0;32m'
KUNING='\033[0;33m'
MERAH='\033[0;31m'
NC='\033[0m'

clear
echo "=================================================="
echo "  _  _ _  _ ____ _    ____ _ _  _ ____   _  _ ____ "
echo "  |\ |  \/  |__| |    |__| | |\ | | __   |\/| |__| "
echo "  | \|  |   |  | |___ |  | | | \| |__] . |  | |  | "
echo "=================================================="
echo "              DOCKER ENGINE SYSTEM                "
echo "=================================================="
echo -e "[-] Memutar kunci kontak... [ ${HIJAU}OK${NC} ]"
sleep 1

echo -n "[-] Memeriksa mesin (Docker Compose)... "
if [ -f "docker-compose.yml" ]; then
    echo -e "[ ${HIJAU}READY${NC} ]"
else
    echo -e "[ ${MERAH}FILE HILANG${NC} ]"
    exit 1
fi
sleep 1

echo -e "[-] Menghubungkan aliran listrik... [ ${KUNING}STARTING${NC} ]"
docker compose up -d > /dev/null 2>&1

echo -n "[-] Menghidupkan mesin (Container)... [  ]"
for i in {1..3}; do
    echo -ne "\b\b/ ]"
    sleep 0.2
    echo -ne "\b\b- ]"
    sleep 0.2
    echo -ne "\b\b\\\\ ]"
    sleep 0.2
    echo -ne "\b\b| ]"
    sleep 0.2
done
echo -e "\b\b${HIJAU}OK${NC} ]"

if [ "$(docker ps -q -f name=rui-db-1)" ]; then
    echo "=================================================="
    echo -e "[*] STATUS MESIN: [ ${HIJAU}ENGINE NYALA / RUNNING${NC} ]"
    echo "=================================================="
    echo -e "${HIJAU}VROOOM! Sistem rui siap digunakan.${NC}"
    echo "Membuka monitor sistem dalam 3 detik..."
    sleep 3
    
    clear
    docker stats rui-web-1 rui-db-1 dab9e32b8f7b_go-server-go-server-1 rui-rui-1
else
    echo "=================================================="
    echo -e "[!] STATUS MESIN: [ ${MERAH}MOGOK / ERROR${NC} ]"
    echo "=================================================="
    echo "Silakan cek log dengan perintah: docker compose logs"
fi
